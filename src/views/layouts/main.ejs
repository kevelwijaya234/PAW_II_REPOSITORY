<!doctype html>
<html lang="en" class="h-full scroll-smooth antialiased">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/3.46.0/tabler-icons.min.css" integrity="sha512-7YwNeYzQJj3HmACGDk1qmoA8dXPVYp+WIVMjeJMSJ3cfldjq5ob6UcRAM+HlxFozG+9jhGPvli1HimRfKHtXfQ==" crossorigin="anonymous" referrerpolicy="no-referrer">

    <link rel="stylesheet" href="/css/app.css">
</head>

<body class="min-h-dvh flex flex-col bg-slate-50/60 text-slate-900 selection:bg-emerald-500/15 selection:text-emerald-900 relative overflow-x-hidden">
    <!-- Subtle Ambient Glow -->
    <div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden" aria-hidden="true">
        <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[720px] h-[380px] bg-gradient-to-b from-emerald-100/50 via-teal-50/30 to-transparent blur-3xl opacity-70 rounded-full"></div>
    </div>

    <%- body %>
</body>

</html>