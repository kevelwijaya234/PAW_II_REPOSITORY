<main class="max-w-xl mx-auto px-4 sm:px-6 my-auto py-12 sm:py-16 w-full">
    <div class="bg-white/95 backdrop-blur-sm border border-slate-200/80 rounded-3xl p-6 sm:p-12 text-center shadow-xl shadow-slate-200/50">
        <div class="mb-4">
            <span class="inline-block text-6xl sm:text-7xl font-black text-slate-900 tracking-tight select-none">
                4<span class="text-[#58CC02]">0</span>4
            </span>
        </div>

        <h1 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight mb-2">Page Not Found</h1>

        <p class="text-slate-600 text-sm sm:text-base max-w-sm mx-auto mb-8 leading-relaxed text-pretty">
            The page you are looking for doesn't exist, has been removed, or is temporarily unavailable.
        </p>

        <div class="flex justify-center">
            <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-medium text-sm text-white bg-slate-900 hover:bg-slate-800 active:scale-[0.98] transition duration-200 shadow-sm shadow-slate-900/10">
                <i class="ti ti-home text-base text-[#58CC02]"></i>
                Back to Home
            </a>
        </div>
    </div>
</main>

<footer class="py-6 text-center mt-auto border-t border-slate-200/60 bg-white/50 backdrop-blur-xs">
    <div class="max-w-7xl mx-auto px-4 text-slate-500 text-xs font-medium">
        &copy; <%= new Date().getFullYear() %> Express ESM Generator.
    </div>
</footer>
