<main class="max-w-2xl mx-auto px-4 sm:px-6 my-auto py-12 sm:py-16 w-full">
    <div class="bg-white/95 backdrop-blur-sm border border-slate-200/80 rounded-3xl p-6 sm:p-12 text-center shadow-xl shadow-slate-200/50 relative">
        <div class="mb-6 flex justify-center">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#58CC02]/10 border border-[#58CC02]/30 text-[#58CC02] text-[11px] font-semibold tracking-wide">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#58CC02] opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-[#58CC02]"></span>
                </span>
                ES Modules Ready
            </span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-[1.12] mb-4 text-balance">
            Welcome to <br>
            <span class="text-[#58CC02]">Express ESM Generator</span>
        </h1>

        <p class="text-slate-600 text-sm sm:text-base max-w-md mx-auto mb-8 leading-relaxed text-pretty">
            Your Node.js boilerplate is configured and ready. Build fast, scalable web applications with native ESM syntax and Tailwind CSS.
        </p>

        <div class="flex flex-col sm:flex-row justify-center items-center gap-3 mb-8">
            <a href="https://expressjs.com/" target="_blank" rel="noopener noreferrer"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl font-medium text-sm text-white bg-slate-900 hover:bg-slate-800 active:scale-[0.98] transition duration-200 shadow-sm shadow-slate-900/10">
                <i class="ti ti-brand-nodejs text-lg text-[#58CC02]"></i>
                Express Docs
            </a>
            <a href="https://tailwindcss.com/docs" target="_blank" rel="noopener noreferrer"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl font-medium text-sm text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 hover:border-slate-300 active:scale-[0.98] transition duration-200 shadow-sm">
                <i class="ti ti-brand-tailwind text-lg text-sky-500"></i>
                Tailwind Docs
            </a>
        </div>

        <div class="mb-6 flex justify-center">
            <button type="button" onclick="copyCommand()" id="cmdBox"
                class="group inline-flex items-center justify-between gap-4 px-4 py-2.5 rounded-xl bg-slate-100/90 hover:bg-slate-200/70 border border-slate-200/80 font-mono text-xs sm:text-sm cursor-pointer select-none transition duration-150 active:scale-[0.99] focus:outline-none focus:ring-2 focus:ring-[#58CC02]/25"
                title="Click to copy command">
                <div class="flex items-center gap-2">
                    <span class="text-[#58CC02] font-semibold select-none">$</span>
                    <span id="cmdText" class="text-slate-800 font-medium">npm run dev</span>
                </div>
                <div class="flex items-center gap-1.5 pl-3 border-l border-slate-200 text-slate-400 group-hover:text-slate-600">
                    <i id="copyIcon" class="ti ti-copy text-sm transition-transform group-hover:scale-110"></i>
                    <span id="copyFeedback" class="text-[11px] font-sans font-medium hidden text-[#58CC02]">Copied</span>
                </div>
            </button>
        </div>

        <div class="pt-6 border-t border-slate-100 flex justify-center">
            <a href="/api/welcome"
                class="group inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg text-xs font-medium text-slate-500 hover:text-[#58CC02] bg-slate-50 hover:bg-[#58CC02]/10 border border-slate-200/70 hover:border-[#58CC02]/30 transition duration-150">
                <span class="w-1.5 h-1.5 rounded-full bg-[#58CC02]"></span>
                <span class="font-mono text-[11px]">GET /api/welcome</span>
                <i class="ti ti-arrow-right text-xs opacity-50 group-hover:opacity-100 group-hover:translate-x-0.5 transition duration-150"></i>
            </a>
        </div>

    </div>
</main>

<footer class="py-6 text-center mt-auto border-t border-slate-200/60 bg-white/50 backdrop-blur-xs">
    <div class="max-w-7xl mx-auto px-4 text-slate-500 text-xs font-medium">
        &copy; <%= new Date().getFullYear() %> Express ESM Generator. Built with Express & Tailwind CSS.
    </div>
</footer>

<script>
    function copyCommand() {
        const text = document.getElementById('cmdText').innerText;
        navigator.clipboard.writeText(text);

        const icon = document.getElementById('copyIcon');
        const feedback = document.getElementById('copyFeedback');
        
        icon.className = 'ti ti-check text-sm text-[#58CC02]';
        if (feedback) feedback.classList.remove('hidden');

        setTimeout(() => {
            icon.className = 'ti ti-copy text-sm text-slate-400';
            if (feedback) feedback.classList.add('hidden');
        }, 2000);
    }
</script>